--!strict
-- Metadata for every random event. Behaviour lives in ServerScriptService
-- Server/Events/<id>.luau; this table is shared so the client can show names,
-- icons and warnings. `tags` + `incompatible` stop impossible combinations.

export type EventDef = {
	id: string,
	name: string,
	description: string,
	icon: string,
	color: Color3,
	duration: number,
	warnTime: number, -- announcement before the effect starts
	difficulty: number, -- 1 (helpful/mild) .. 5 (brutal)
	weight: number, -- relative probability among eligible events
	minElapsed: number, -- never before this many seconds of round time
	cooldown: number, -- seconds before the same event may run again
	tags: { string },
	incompatible: { string },
	sound: string,
	scheduledOnly: boolean?,
}

